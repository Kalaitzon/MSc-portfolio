      <div class="mx-auto max-w-[1200px] px-4 py-5 sm:px-6 lg:px-8">
        <p class="text-center text-[11px] text-slate-400 dark:text-slate-500">
          © 2026 Ioannis Kalaitzidis. All rights reserved.
        </p>
      </div>
    </footer>

    <!-- ═══ SCRIPTS ════════════════════════════════════════════════════════ -->
    <script is:inline>
      (function () {
        const root = document.documentElement;

        /* ── 0. Ethics modal ──────────────────────────────────────── */
        (function() {
          const modal   = document.getElementById("ethics-modal");
          const closeBtn = document.getElementById("ethics-close");
          const langBtn  = document.getElementById("ethics-lang");
          const body     = document.getElementById("ethics-body");
          if (!modal) return;

          const EN_TEXT = "This portfolio documents academic assignments completed as part of an MSc programme in Cybersecurity and Artificial Intelligence Technologies. All practical work involving offensive security techniques — such as network attacks, exploitation, and malware analysis — was conducted exclusively in controlled, isolated laboratory environments for educational purposes only. No real systems, networks, or individuals were targeted at any point.";
          const EL_TEXT = "Αυτό το portfolio τεκμηριώνει ακαδημαϊκές εργασίες που εκπονήθηκαν στο πλαίσιο Μεταπτυχιακού Προγράμματος Σπουδών στην Κυβερνοασφάλεια και Τεχνολογίες Τεχνητής Νοημοσύνης. Όλες οι πρακτικές εργασίες που περιλαμβάνουν τεχνικές επίθεσης — όπως επιθέσεις σε δίκτυα, εκμετάλλευση ευπαθειών και ανάλυση κακόβουλου λογισμικού — πραγματοποιήθηκαν αποκλειστικά σε ελεγχόμενα, απομονωμένα εργαστηριακά περιβάλλοντα, για εκπαιδευτικούς σκοπούς μόνο. Σε κανένα στάδιο δεν στοχεύτηκαν πραγματικά συστήματα, δίκτυα ή άτομα.";

          const title    = document.getElementById("ethics-title");
          const EN_TITLE = "Educational and Research Context";
          const EL_TITLE = "Εκπαιδευτικό και Ερευνητικό Πλαίσιο";

          let showingEL = false;
          langBtn.addEventListener("click", function() {
            showingEL = !showingEL;
            title.textContent       = showingEL ? EL_TITLE : EN_TITLE;
            body.textContent        = showingEL ? EL_TEXT  : EN_TEXT;
            langBtn.textContent     = showingEL ? "Show in English" : "Εμφάνιση στα Ελληνικά";
            closeBtn.textContent    = showingEL ? "Το κατανοώ" : "I understand";
          });

          closeBtn.addEventListener("click", function() {
            modal.style.display = "none";
          });
        })();

        /* ── 1. Θέμα (Dark / Light) ─────────────────────────────────────── */
        document.getElementById("theme-toggle").addEventListener("click", () => {
          root.classList.toggle("dark");
        });

        /* ── 2. Γλώσσα (EN / EL) ────────────────────────────────────────── */
        const langLabel = document.getElementById("lang-label");

        function applyLang(lang) {
          root.lang = lang;
          root.dataset.lang = lang;
          langLabel.textContent = lang === "el" ? "ΕΛ" : "EN";

          // Κάθε στοιχείο με data-en / data-el αλλάζει κείμενο.
          document.querySelectorAll("[data-en]").forEach((el) => {
            const text = lang === "el" ? el.dataset.el : el.dataset.en;
            if (text) el.textContent = text;
          });

          // Κουμπιά PDF: άλλαξε σύνδεσμο ανάλογα με τη γλώσσα (αν υπάρχει αγγλικό PDF).
          document.querySelectorAll("[data-href-en]").forEach((a) => {
            const href = lang === "el" ? a.dataset.hrefEl : a.dataset.hrefEn;
            if (href) a.setAttribute("href", href);
          });

          localStorage.setItem("lang", lang);
        }

        document.getElementById("lang-toggle").addEventListener("click", () => {
          applyLang(root.dataset.lang === "el" ? "en" : "el");
        });

        applyLang(localStorage.getItem("lang") || "en");

        /* ── 3. Εναλλαγή εξαμήνων ───────────────────────────────────────── */
        const tabs = document.querySelectorAll("[data-semester-tab]");
        const panels = document.querySelectorAll("[data-semester-panel]");

        tabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            const target = tab.dataset.semesterTab;

            tabs.forEach((t) =>
              t.setAttribute(
                "aria-selected",
                t.dataset.semesterTab === target ? "true" : "false"
              )
            );

            panels.forEach((p) => {
              const active = p.dataset.semesterPanel === target;
              p.classList.toggle("hidden", !active);
              p.classList.toggle("flex", active);
            });

            // semester tab saved intentionally omitted — always opens on Winter
          });
        });

        // Winter semester is always the default — no localStorage restore
      })();
    </script>
  </body>
</html>
